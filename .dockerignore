# Git
.git
.gitignore
.dockerignore
.github/
.gitattributes

# IDE/OS
.idea/
.vscode/
*.swp
.DS_Store

# Node / pnpm
node_modules/
.pnpm-store/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
env/
venv/

# Logs / test / dev
*.log
logs/
test-results/
frontend/test-results/
pytest*.log

# Runtime data (volumes in prod)
# NOTE: we exclude generated runtime files, but seed data files must be available
# for the Dockerfile COPY step. Use negation to keep only the small seed files.
media/
data/
!data/cfg1.json
!data/projects.jsonl
chroma_db/

# Dev builds (Docker rebuilds them)
frontend/node_modules/
artifacts/**/node_modules/
frontend/dist/
artifacts/concierge/dist/

# ── Secrets (critical - never bake real env/secrets into image) ──────────────
# Explicitly ignore ALL environment and secret files so no keys ever enter the image.
.env
.env.*
.env.local
.env.*.local
!.env.example

*.pem
*.key
*.crt
*.p12
*.jks
secrets/
*.secret
*.token
*.apikey
*.credentials

# Recursively ignore in all subdirectories
**/.env
**/.env.*
**/.env.local
**/.env.*.local
**/secrets/
**/*.pem
**/*.key
**/*.token

# ── Additional bloat reduction for faster builds ─────────────────────────────
# Git and CI
.git/
.gitignore
.github/
.gitattributes

# Docs and misc (keep only what's needed)
*.md
!README.md
*.txt
!requirements*.txt
!package.json
!pnpm-*.yaml
!pnpm-lock.yaml

# Test and dev only
**/__tests__/
**/*.test.*
**/*.spec.*
test-results/
coverage/

# Caches and temp
.cache/
.tmp/
*.tmp
*.bak
*.swp
*~

# Additional logs
**/*.log
**/*.log.*

# Docker self
docker-compose*.yml
Dockerfile*
.docker/
