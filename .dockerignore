# ── Version control ───────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── Node / pnpm ───────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
# Built artefacts are produced inside Docker — never copy local builds in
artifacts/*/dist/
artifacts/*/build/
*.tsbuildinfo

# ── Other artifact packages not needed by Docker ─────────────────────────────
# Only artifacts/concierge (the web frontend) is built in the image.
# Mobile app, API server, and mockup sandbox are excluded.
artifacts/concierge-mobile/
artifacts/api-server/
artifacts/mockup-sandbox/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
.pythonlibs/
.venv/
venv/
.pytest_cache/

# ── Replit-specific ───────────────────────────────────────────────────────────
.replit
replit.nix
.replitignore
.cache/
.local/
.config/
.agents/

# ── Secrets / environment files ───────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Large/sensitive runtime files ─────────────────────────────────────────────
memory_backup.jsonl
*.jsonl
.migration-backup/
media/
data/
screenshots/
attached_assets/

# ── Editor / OS artefacts ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-workspace

# ── Test artefacts ────────────────────────────────────────────────────────────
coverage/
playwright-report/
test-results/
htmlcov/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log
