# Concierge environment configuration — EXAMPLE
# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.

# OpenAI — required for DALL-E 3 image generation, GPT responses, and embeddings
OPENAI_API_KEY=sk-...

# Optional: override the OpenAI API base URL (e.g. for Azure OpenAI or proxies)
# OPENAI_API_BASE=https://api.openai.com/v1

# Optional: override the default response token budget for LLM calls.
# LLM_MAX_TOKENS=1024

# Slack integration (optional)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Stripe integration (optional)
# STRIPE_SECRET_KEY=sk_test_...
