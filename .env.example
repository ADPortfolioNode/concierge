# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.

# ── LLM providers (at least one required) ────────────────────────────────────

# Google Gemini (modern model recommended)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI / ChatGPT
OPENAI_API_KEY=sk-your-openai-key-here
CHAT_GPT_API_KEY=sk-your-openai-key-here

# xAI Grok
GROK_API_KEY=xai-your-grok-key-here
GROK_API_BASE=https://api.x.ai/v1
GROK_MODEL=grok-3-mini-beta

# Optional: override the OpenAI API base URL (e.g. for Azure OpenAI or proxies)
# OPENAI_API_BASE=https://api.openai.com/v1

# Optional: override the default response token budget for LLM calls.
# LLM_MAX_TOKENS=1024

# ── Server ────────────────────────────────────────────────────────────────────
HOST_PORT=8000        # host port mapped to container's 8000
WORKERS=2             # gunicorn worker count (default: 2)
LOG_LEVEL=info        # uvicorn/gunicorn log level

# Slack integration (optional)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Stripe integration (optional)
# STRIPE_SECRET_KEY=sk_test_...

# ── Celery (only needed with --profile full) ──────────────────────────────────
CELERY_CONCURRENCY=4

# Resilience flags (bare / no-docker / local dev ONLY)
#   When using `docker compose --profile full` or ./start.sh --full,
#   leave these unset (settings.py defaults are enabled) OR set REDIS_ENABLED=true.
#   Copying the false values below will make the API side avoid queuing work to the
#   Celery worker even though Redis + worker containers are running.
REDIS_ENABLED=false
USE_INLINE_TASKS=true
CELERY_ENABLED=false
