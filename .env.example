# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.

# ── LLM providers (at least one required) ────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AI...

# Optional: override the OpenAI API base URL (e.g. for Azure OpenAI or proxies)
# OPENAI_API_BASE=https://api.openai.com/v1

# Optional: override the default response token budget for LLM calls.
# LLM_MAX_TOKENS=1024

# ── Server ────────────────────────────────────────────────────────────────────
HOST_PORT=8000        # host port mapped to container's 8000
WORKERS=2             # gunicorn worker count (default: 2)
LOG_LEVEL=info        # uvicorn/gunicorn log level

# Slack integration (optional)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Stripe integration (optional)
# STRIPE_SECRET_KEY=sk_test_...

# ── Celery (only needed with --profile full) ──────────────────────────────────
CELERY_CONCURRENCY=4
