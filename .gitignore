# Recommended .gitignore for a Python/Node.js project to establish a clean ground truth.

# ── Secrets / Environment Files ───────────────────────────────────────────────
# Ignore all .env files, but keep the example for onboarding.
.env
.env.*
!.env.example

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-error.log
playwright_backend.log
playwright_backend_live.log

# ── Python ────────────────────────────────────────────────────────────────────
# Virtual environments
.venv/
venv/
env/

# Caches and artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
dist/
build/

# ── OS / IDE specific ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/

# ── Local Data & Backups ──────────────────────────────────────────────────────
.migration-backup/
.snapshots/
media/
data/
chroma_db/
qdrant_data/
volumes/
memory_backup.jsonl
*.zip