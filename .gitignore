# Recommended .gitignore for a Python/Node.js project to establish a clean ground truth.

# ── Secrets / Environment Files ───────────────────────────────────────────────
# NEVER commit real secrets or keys. Only .env.example (with placeholders) is allowed.
.env
.env.*
.env.local
.env.*.local
!.env.example

# Additional secret-related files
*.pem
*.key
*.crt
*.p12
*.jks
secrets/
*.secret
*.env
id_rsa*
id_dsa*
*.token
*.apikey
*.credentials

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-error.log
playwright_backend.log
playwright_backend_live.log

# ── Python ────────────────────────────────────────────────────────────────────
# Virtual environments
.venv/
venv/
env/

# Caches and artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
dist/
build/

# ── OS / IDE specific ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/

# ── Local Data & Backups ──────────────────────────────────────────────────────
.migration-backup/
.snapshots/
media/
data/
chroma_db/
qdrant_data/
volumes/
memory_backup.jsonl
*.zip

# ── Additional project-specific ignores ──────────────────────────────────────
# Caches
.cache/
.swc/
.turbo/
*.tsbuildinfo

# Additional logs and debug
*.log.*
pnpm-debug.log*
.eslintcache

# Secrets & keys (extra protection)
*.pem
*.key
*.crt
secrets/
*.secret

# Docker compose overrides (local only)
docker-compose.override.yml
docker-compose.*.yml
!docker-compose.yml

# Temporary / backup
*.bak
*.tmp
*.swp
*~

# Agent / IDE session artifacts (local only)
terminals/
agent-tools/
mcps/
test_phase6_out*.txt

# Accidental local scratch files
Cleaning
[runtime