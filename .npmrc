auto-install-peers=false
strict-peer-dependencies=false

# Hoist native bindings so they are resolvable from sub-packages
# even when disabled via overrides in pnpm-workspace.yaml (for the Docker Linux build).
public-hoist-pattern[]=*lightningcss*
public-hoist-pattern[]=*rollup*
public-hoist-pattern[]=*@tailwindcss/oxide*
